{
    "swagger": "2.0",
    "info": {
        "description": "Movie booking API: browse movies and showtimes, hold seats, book tickets.",
        "title": "Booking API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/auth/login": {
            "post": {
                "description": "Validates credentials and returns a 15-minute JWT access token.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Log in",
                "parameters": [
                    {
                        "description": "Credentials",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_user.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_user.LoginResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid request body",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Invalid email or password",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/auth/register": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Register a new user",
                "parameters": [
                    {
                        "description": "New account",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_user.RegisterRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/internal_user.User"
                        }
                    },
                    "400": {
                        "description": "Validation error",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Email already registered",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/movies/{id}/showtimes": {
            "get": {
                "description": "Retrieve upcoming showtimes for a movie within a date range. Dates use YYYY-MM-DD. The \"date\" parameter is an alternative to \"from\". If no dates are provided, today's date is used. The range is limited to 31 days.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Showtimes"
                ],
                "summary": "List movie showtimes",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Movie UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "2026-12-20",
                        "description": "Start date (YYYY-MM-DD)",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "2026-12-25",
                        "description": "End date, inclusive (YYYY-MM-DD)",
                        "name": "to",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "2026-12-20",
                        "description": "Alternative start date if from is omitted (YYYY-MM-DD)",
                        "name": "date",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/internal_showtime.ListItem"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/screens/{id}": {
            "get": {
                "description": "Retrieve a screen and its seats grouped by row. Each row contains its label and corresponding seats.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Screens"
                ],
                "summary": "Get screen layout",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Screen UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_theater.ScreenLayout"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/showtimes": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Schedule a movie on a screen. The start time must be in the future. The end time is calculated from the movie duration plus a 15-minute cleaning buffer. Overlapping showtimes on the same screen are rejected. Requires admin access.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Showtimes"
                ],
                "summary": "Create a showtime",
                "parameters": [
                    {
                        "description": "Showtime details",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_showtime.CreateShowtimeRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/internal_showtime.Showtime"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/showtimes/{id}": {
            "get": {
                "description": "Retrieve an active showtime by its UUID, including its movie, screen, start time, end time, and ticket price.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Showtimes"
                ],
                "summary": "Get a showtime",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Showtime UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_showtime.Showtime"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/theaters": {
            "get": {
                "description": "Retrieve all active theaters ordered by creation date. Returns an empty array if no theaters exist.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Theaters"
                ],
                "summary": "List theaters",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/internal_theater.Theater"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Create a new theater. The theater name and city must be provided and cannot exceed 100 characters. Requires admin access.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Theaters"
                ],
                "summary": "Create a theater",
                "parameters": [
                    {
                        "description": "Theater details",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_theater.CreateTheater"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/internal_theater.Theater"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/theaters/{id}/screens": {
            "get": {
                "description": "Retrieve all active screens belonging to a theater. Returns an empty array if no active screens exist.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Screens"
                ],
                "summary": "List theater screens",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Theater UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/internal_theater.Screen"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Create a screen in a theater and automatically generate its seats. Rows must be between 1 and 26, and seats per row must be between 1 and 50. Requires admin access.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Screens"
                ],
                "summary": "Create a screen",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Theater UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Screen details",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_theater.CreateScreenRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/internal_theater.Screen"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "github_com_amanuel-tk_Booking-Api_internal_httpx.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "internal_showtime.CreateShowtimeRequest": {
            "type": "object",
            "properties": {
                "movie_id": {
                    "type": "string",
                    "format": "uuid"
                },
                "price_cents": {
                    "type": "integer",
                    "maximum": 10000000,
                    "minimum": 0,
                    "example": 15000
                },
                "screen_id": {
                    "type": "string",
                    "format": "uuid"
                },
                "starts_at": {
                    "type": "string",
                    "example": "2026-12-20T18:00:00+03:00"
                }
            }
        },
        "internal_showtime.ListItem": {
            "type": "object",
            "properties": {
                "ends_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "price_cents": {
                    "type": "integer"
                },
                "screen_id": {
                    "type": "string"
                },
                "screen_name": {
                    "type": "string"
                },
                "starts_at": {
                    "type": "string"
                },
                "theater_id": {
                    "type": "string"
                },
                "theater_name": {
                    "type": "string"
                }
            }
        },
        "internal_showtime.Showtime": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "ends_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "is_active": {
                    "type": "boolean"
                },
                "movie_id": {
                    "type": "string"
                },
                "price_cents": {
                    "type": "integer"
                },
                "screen_id": {
                    "type": "string"
                },
                "starts_at": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "internal_theater.CreateScreenRequest": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "maxLength": 100,
                    "example": "screen 1"
                },
                "rows": {
                    "type": "integer",
                    "maximum": 26,
                    "minimum": 1,
                    "example": 10
                },
                "seats_per_row": {
                    "type": "integer",
                    "maximum": 50,
                    "minimum": 1,
                    "example": 15
                }
            }
        },
        "internal_theater.CreateTheater": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string",
                    "maxLength": 100,
                    "example": "addis ababa"
                },
                "name": {
                    "type": "string",
                    "maxLength": 100,
                    "example": "cinema ethiopia"
                }
            }
        },
        "internal_theater.Screen": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "is_active": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "row_count": {
                    "type": "integer"
                },
                "seats_per_row": {
                    "type": "integer"
                },
                "theater_id": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "internal_theater.ScreenLayout": {
            "type": "object",
            "properties": {
                "rows": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/internal_theater.SeatRow"
                    }
                },
                "screen": {
                    "$ref": "#/definitions/internal_theater.Screen"
                }
            }
        },
        "internal_theater.Seat": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "format": "uuid"
                },
                "row_label": {
                    "type": "string",
                    "example": "A"
                },
                "seat_number": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "internal_theater.SeatRow": {
            "type": "object",
            "properties": {
                "row": {
                    "type": "string",
                    "example": "A"
                },
                "seats": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/internal_theater.Seat"
                    }
                }
            }
        },
        "internal_theater.Theater": {
            "type": "object",
            "properties": {
                "city": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "is_active": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "internal_user.LoginRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email",
                    "example": "jane@example.com"
                },
                "password": {
                    "type": "string",
                    "example": "s3cretPass!"
                }
            }
        },
        "internal_user.LoginResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIs..."
                },
                "token_type": {
                    "type": "string",
                    "example": "Bearer"
                },
                "user": {
                    "$ref": "#/definitions/internal_user.User"
                }
            }
        },
        "internal_user.RegisterRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email",
                    "example": "jane@example.com"
                },
                "first_name": {
                    "type": "string",
                    "minLength": 1,
                    "example": "Jane"
                },
                "last_name": {
                    "type": "string",
                    "minLength": 1,
                    "example": "Doe"
                },
                "password": {
                    "type": "string",
                    "maxLength": 72,
                    "minLength": 8,
                    "example": "s3cretPass!"
                }
            }
        },
        "internal_user.User": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "email": {
                    "type": "string",
                    "example": "jane@example.com"
                },
                "first_name": {
                    "type": "string",
                    "example": "jane"
                },
                "id": {
                    "type": "string",
                    "format": "uuid",
                    "example": "3f2b8c1e-5a7d-4e6f-9b1a-2c3d4e5f6a7b"
                },
                "is_active": {
                    "type": "boolean"
                },
                "last_name": {
                    "type": "string",
                    "example": "doe"
                },
                "permissions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "roles": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "user"
                    ]
                },
                "updated_at": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Type \"Bearer \" followed by your JWT.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}